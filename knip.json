{
  "ignore": [
    "apps/dashboard/src/route-tree.gen.ts",
    "packages/runtime/dist/**",
    "third_party/**",
    "**/tests/**",
    "**/*.test.*",
    "**/*.spec.*",
    "test/**"
  ],
  "ignoreWorkspaces": ["test/applications/*", "third_party/*"],
  "ignoreDependencies": ["tailwindcss"],
  "ignoreBinaries": ["mbx", "ocd"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts"],
      "ignoreDependencies": ["@cloudflare/vite-plugin", "vite"]
    },
    "apps/website": {
      "entry": [
        "astro.config.ts",
        "src/pages/**/*.astro",
        "src/dev-api-route.ts",
        "src/starlight-route.ts",
        "src/components/docs-sidebar.astro",
        "src/components/docs-site-title.astro",
        "functions/**/*.ts",
        "src/worker.ts",
        "cloudflare.config.ts",
        "vite.config.ts"
      ],
      "project": [
        "src/**/*.{astro,ts,tsx}",
        "functions/**/*.ts",
        "astro.config.ts",
        "cloudflare.config.ts",
        "vite.config.ts"
      ],
      "ignoreDependencies": ["@iconify-json/tabler", "cookie", "satteri"]
    },
    "packages/sdk": {
      "entry": [
        "src/index.ts",
        "src/generated.ts",
        "scripts/build.ts",
        "scripts/generate.ts",
        "scripts/inspect-package.ts"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "apps/dashboard": {
      "entry": ["src/main.tsx", "vite.config.ts", "playwright.config.ts"],
      "project": ["src/**/*.{ts,tsx}", "*.ts"]
    },
    "packages/runtime": {
      "entry": ["build.ts", "src/**/*.ts", "src/**/*.d.ts"],
      "project": ["build.ts", "src/**/*.ts", "src/**/*.d.ts"],
      "ignoreDependencies": ["cloudflare", "cloudflare-internal"]
    },
    "packages/browser-actions": {
      "entry": ["src/index.ts", "src/live-view.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/workers-types": {
      "entry": ["index.d.ts"],
      "project": ["index.d.ts"]
    },
    "examples/hello-worker": {
      "entry": ["src/index.ts", "*.config.ts"],
      "project": ["src/**/*.ts", "*.config.ts"]
    },
    "examples/stress-demo": {
      "entry": ["src/index.ts", "*.config.ts"],
      "project": ["src/**/*.ts", "*.config.ts"],
      "ignoreDependencies": ["cloudflare"]
    }
  }
}
