# Rust and Cargo output.
/debug/
/target/
/.cargo-home/
**/*.rs.bk
*.pdb
*.profraw

# Mutation testing output.
**/mutants.out*/

# Repository-local development state.
/.data/

# G0 workerd spike: official binary cache and successful-run temp artifacts.
# Keep source, fixtures, tests, lockfiles, and retained failure evidence.
/poc/.runtime-cache/
/poc/.run/*

# Successful P0.1 run artifacts. Retain failure evidence under failed/.
/.p0-1-run/*
!/.p0-1-run/failed/
!/.p0-1-run/failed/**
