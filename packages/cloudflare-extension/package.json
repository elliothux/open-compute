{
  "name": "@open-compute/cloudflare-extension",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://open-compute.dev",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "check:schema": "bun scripts/generate-types.ts --check",
    "generate": "bun scripts/generate-types.ts",
    "test": "bun test tests/*.test.mjs",
    "typecheck": "bun run check:schema && tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "cloudflare": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
