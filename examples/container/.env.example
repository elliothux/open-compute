# Copy to .env before `docker compose up -d`.

# Auth tokens (must be distinct; copied to private files on first initialization)
OPEN_COMPUTE_ADMIN_TOKEN=change-me-admin
OPEN_COMPUTE_DEPLOYER_TOKEN=change-me-deployer
OPEN_COMPUTE_READ_ONLY_TOKEN=change-me-readonly

# Host listener (the container always listens on port 8787)
OC_PUBLIC_PORT=8787
OC_HOST_BIND=127.0.0.1

# Local object storage (default)
OC_STORAGE_BACKEND=local

# External S3 (enable with: docker compose -f docker-compose.yml -f docker-compose.external-s3.yml up -d)
# OC_STORAGE_BACKEND=s3
# OC_EXTERNAL_NETWORK=1panel-network
# OC_S3_ENDPOINT=http://1Panel-rustfs-R3pn:9000
# OC_S3_REGION=us-east-1
# OC_S3_BUCKET=open-compute
# OC_S3_PREFIX=open-compute/system/
# OC_S3_R2_PREFIX=open-compute/tenant/r2/
# OC_S3_ACCESS_KEY_ID=rustfsadmin
# OC_S3_SECRET_ACCESS_KEY=change-me
