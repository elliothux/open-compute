<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.open-compute.ocd</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/open-compute/ocd</string>
    <string>--config</string>
    <string>/usr/local/etc/open-compute/config.toml</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/usr/local/var/open-compute</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>2</integer>
  <key>ExitTimeOut</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>/usr/local/var/log/open-compute/ocd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/usr/local/var/log/open-compute/ocd.err.log</string>
</dict>
</plist>
