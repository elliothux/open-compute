FROM debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates passwd python3 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 501 --gid 20 --shell /bin/bash oc-test \
    && mkdir /src \
    && chown 501:20 /src
COPY mbx /usr/local/bin/mbx
USER oc-test
RUN mbx settings set build_script_execution false \
    && mbx settings set target.views false \
    && mbx settings set restore_hardlink false \
    && mbx settings set gc.auto false
WORKDIR /src
