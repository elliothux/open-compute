  "scriptTail": {
    "source": "fixed Wrangler source plus local real-process differential",
    "create": {
      "method": "POST",
      "path": "/accounts/ACCOUNT/workers/scripts/SCRIPT/tails",
      "requestShape": ["filters"],
      "responseShape": ["expires_at", "id", "url"]
    },
    "webSocket": {
      "subprotocol": "trace-v1",
      "initialClientFrame": {"debug": false},
      "eventFields": ["event", "eventTimestamp", "exceptions", "logs", "outcome", "scriptName"]
    },
    "heartbeatSeconds": 10,
    "cleanup": "DELETE /accounts/ACCOUNT/workers/scripts/SCRIPT/tails/TAIL"
  },
  "dashboardLiveTail": {
    "source": "authenticated Cloudflare Dashboard network differential against a disposable Worker",
    "prepare": {
      "method": "POST",
      "path": "/accounts/ACCOUNT/workers/observability/telemetry/live-tail",
      "body": {
        "scriptId": "SCRIPT",
        "filters": [
          {"key": "$workers.preview.slug", "type": "string", "operation": "is_null"}
        ],
        "filterCombination": "and"
      },
      "responseShape": ["wsUrl"]
    },
    "webSocket": {
      "subprotocol": null,
      "queryKeys": ["token", "userId", "key", "accountTag"],
      "serverEventFields": ["$metadata", "$workers", "dataset", "source", "timestamp"],
      "eventPerFrame": true
    },
    "heartbeat": {
      "intervalSeconds": 15,
      "method": "POST",
      "path": "/accounts/ACCOUNT/workers/observability/telemetry/live-tail/heartbeat",
      "body": {"scriptId": "SCRIPT"},
      "response": {}
    }
  },
  "stockWorkerdTopology": {
