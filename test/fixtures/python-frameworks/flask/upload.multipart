Content-Disposition: form-data; name="./python_modules/markupsafe/_native.py"; filename="./python_modules/markupsafe/_native.py"
Content-Type: application/octet-stream

def _escape_inner(s: str, /) -> str:
    return (
        s.replace("&", "&amp;")
        .replace(">", "&gt;")
        .replace("<", "&lt;")
        .replace("'", "&#39;")
        .replace('"', "&#34;")
    )

