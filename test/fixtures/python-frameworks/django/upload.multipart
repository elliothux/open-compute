msgstr "సంబంధించిన `%(app_label)s.%(data_type)s` అంశము"

#, python-format
msgid "related `%(app_label)s.%(object_name)s` objects"
msgstr "సంబంధించిన `%(app_label)s.%(object_name)s` వస్తువులు"

