msgstr "Password reset confirmation"

msgid ""
"Please enter your new password twice so we can verify you typed it in "
"correctly."
msgstr ""
"Please enter your new password twice so we can verify you typed it in "
"correctly."

msgid "New password:"
msgstr "New password:"

msgid "Confirm password:"
msgstr "Confirm password:"

