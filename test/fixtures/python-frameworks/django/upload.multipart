msgstr "“%(path)s” ne obstaja"

#, python-format
msgid "Index of %(directory)s"
msgstr "Vsebina mape %(directory)s"

msgid "The install worked successfully! Congratulations!"
msgstr "Namestitev se je uspešno izvedla! Čestitke!"

