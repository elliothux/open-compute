msgstr "मानहरु राख्नुहोस"

msgid "Enter a complete value."
msgstr "पुरा मान राख्नु होस ।"

msgid "Enter a valid UUID."
msgstr "उपयुक्त UUID राख्नु होस ।"

msgid "Enter a valid JSON."
msgstr ""

