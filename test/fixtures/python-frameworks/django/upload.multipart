msgid "%(app)s administration"
msgstr ""

msgid "Page not found"
msgstr "ಪುಟ ಸಿಗಲಿಲ್ಲ"

msgid "We're sorry, but the requested page could not be found."
msgstr "ಕ್ಷಮಿಸಿ, ನೀವು ಕೇಳಿದ ಪುಟ ಸಿಗಲಿಲ್ಲ"

msgid "Home"
msgstr "ಪ್ರಾರಂಭಸ್ಥಳ(ಮನೆ)"

msgid "Server error"
msgstr "ಸರ್ವರ್ ದೋಷ"

