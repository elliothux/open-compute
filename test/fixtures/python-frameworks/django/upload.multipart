Content-Disposition: form-data; name="./python_modules/django/contrib/admin/static/admin/js/prepopulate_init.js"; filename="./python_modules/django/contrib/admin/static/admin/js/prepopulate_init.js"
Content-Type: application/octet-stream

"use strict";
{
    const $ = django.jQuery;
    const fields = $("#django-admin-prepopulated-fields-constants").data(
        "prepopulatedFields",
    );
    $.each(fields, function (index, field) {
        $(
            ".empty-form .form-row .field-" +
                field.name +
                ", .empty-form.form-row .field-" +
                field.name +
                ", .empty-form .form-row.field-" +
                field.name,
        ).addClass("prepopulated_field");
        $(field.id)
            .data("dependency_list", field.dependency_list)
            .prepopulate(
                field.dependency_ids,
                field.maxLength,
                field.allowUnicode,
            );
    });
}

