msgstr "“%(value)s” no es un UUID válido."

msgid "Universally unique identifier"
msgstr "Identificador universalmente único"

msgid "File"
msgstr "Archivo"

msgid "Image"
msgstr "Imagen"

msgid "A JSON object"
msgstr "Un objeto JSON"

msgid "Value must be valid JSON."
msgstr "El valor debe ser JSON válido."

#, python-format
