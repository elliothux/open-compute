#, python-format
msgid "Successfully deleted %(count)d %(items)s."
msgstr "Successfully deleted %(count)d %(items)s."

#, python-format
msgid "Cannot delete %(name)s"
msgstr "Cannot delete %(name)s"

msgid "Are you sure?"
msgstr "Are you sure?"

