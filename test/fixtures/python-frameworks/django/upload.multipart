msgid ""
msgstr ""
"Project-Id-Version: django\n"
"Report-Msgid-Bugs-To: \n"
"POT-Creation-Date: 2026-05-20 15:53-0400\n"
"PO-Revision-Date: 2026-08-05 07:59+0000\n"
"Last-Translator: Claude Paroz <claude@2xlibre.net>, "
"2014-2017,2020-2023,2025-2026\n"
"Language-Team: French (http://app.transifex.com/django/django/language/fr/)\n"
