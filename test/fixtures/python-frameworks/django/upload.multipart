msgstr "Past 7 days"

msgid "This month"
msgstr "This month"

msgid "This year"
msgstr "This year"

msgid "No date"
msgstr "No date"

msgid "Has date"
msgstr "Has date"

#, python-format
msgid ""
"Please enter the correct %(username)s and password for a staff account. Note "
"that both fields may be case-sensitive."
msgstr ""
"Please enter the correct %(username)s and password for a staff account. Note "
"that both fields may be case-sensitive."

msgid "Action:"
msgstr "Action:"

