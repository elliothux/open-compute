msgstr ""

msgid "Date:"
msgstr "Azemz:"

msgid "Time:"
msgstr "Akud:"

msgid "Lookup"
msgstr "Anadi"

msgid "Currently:"
msgstr "Tura:"

msgid "Change:"
msgstr "Beddel:"

