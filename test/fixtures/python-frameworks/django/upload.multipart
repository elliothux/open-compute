msgstr "यो फाँट अनिवार्य छ ।"

msgid "Enter a whole number."
msgstr "संख्या राख्नुहोस ।"

msgid "Enter a valid date."
msgstr "उपयुक्त मिति राख्नुहोस ।"

msgid "Enter a valid time."
msgstr "उपयुक्त समय राख्नुहोस ।"

