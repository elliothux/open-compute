msgstr ""

msgid "Email address"
msgstr ""

msgid "File path"
msgstr "ផ្លូវទៅកាន់ឯកសារ"

#, python-format
msgid "“%(value)s” value must be a float."
msgstr ""

msgid "Floating point number"
msgstr ""

