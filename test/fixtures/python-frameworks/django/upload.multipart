msgstr "네팔어"

msgid "Dutch"
msgstr "네덜란드어"

msgid "Norwegian Nynorsk"
msgstr "노르웨이어(뉘노르스크)"

msgid "Ossetic"
msgstr "오세트어"

msgid "Punjabi"
msgstr "펀자브어"

