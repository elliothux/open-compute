Content-Disposition: form-data; name="./python_modules/django/contrib/admin/templates/admin/includes/object_delete_summary.html"; filename="./python_modules/django/contrib/admin/templates/admin/includes/object_delete_summary.html"
Content-Type: application/octet-stream

{% load i18n %}
<h2>{% translate "Summary" %}</h2>
<ul>
    {% for model_name, object_count in model_count %}
    <li>{{ model_name|capfirst }}: {{ object_count }}</li>
    {% endfor %}
