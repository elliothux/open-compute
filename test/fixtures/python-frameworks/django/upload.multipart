msgstr "Svi datumi"

msgid "Today"
msgstr "Danas"

msgid "Past 7 days"
msgstr "Poslednjih 7 dana"

msgid "This month"
msgstr "Ovaj mesec"

msgid "This year"
msgstr "Ova godina"

