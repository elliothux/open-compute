msgid "Enter a valid IPv4 address."
msgstr "उपयुक्त IPv4 ठेगाना राख्नुहोस"

msgid "Enter a valid IPv6 address."
msgstr "उपयुक्त IPv6 ठेगाना राख्नुहोस ।"

