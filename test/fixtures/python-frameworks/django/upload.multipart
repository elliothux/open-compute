msgstr "ሌላ %(verbose_name)s ጨምር"

msgid "Remove"
msgstr "አጥፋ"

msgid "action time"
msgstr "ተግባሩ የተፈፀመበት ጊዜ"

msgid "user"
msgstr ""

msgid "content type"
msgstr ""

msgid "object id"
msgstr ""

