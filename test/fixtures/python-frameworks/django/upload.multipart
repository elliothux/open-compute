      }
      .option p {
        font-weight: 300;
        line-height: 1.25;
        color: light-dark(#525252, white);
        display: table;
      }
      .option .option__heading {
        color: light-dark(#092e20, #6DDCBD);
        font-size: 1.25rem;
        font-weight: 400;
      }
      @media (max-width: 996px) {
