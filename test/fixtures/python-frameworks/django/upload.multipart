msgid "GIS"
msgstr "GIS"

msgid "The base GIS field."
msgstr "La baza GIS kampo."

msgid ""
"The base Geometry field — maps to the OpenGIS Specification Geometry type."
msgstr "La baza Geometry kampo — korelas al la OpenGIS Specifa Geometrio tipo."

msgid "Point"
msgstr "Punkto"

msgid "Line string"
msgstr "Liniŝnuro"

msgid "Polygon"
msgstr "Plurangulo"

msgid "Multi-point"
msgstr "Multpunkto"

