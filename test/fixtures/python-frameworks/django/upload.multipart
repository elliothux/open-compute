msgstr "نعم,لا,ربما"

#, python-format
msgid "%(size)d byte"
msgid_plural "%(size)d bytes"
msgstr[0] "%(size)d بايت"
msgstr[1] "بايت واحد"
msgstr[2] "بايتان"
msgstr[3] "%(size)d بايتان"
msgstr[4] "%(size)d بايت"
msgstr[5] "%(size)d بايت"

