{% spaceless %}
{% for site in sitemaps %}
  <sitemap>
    <loc>{{ site.location }}</loc>
      {% if site.last_mod %}
        <lastmod>{{ site.last_mod|date:"c" }}</lastmod>
      {% endif %}
  </sitemap>
{% endfor %}
{% endspaceless %}
</sitemapindex>

