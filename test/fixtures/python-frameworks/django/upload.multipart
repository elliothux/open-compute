msgstr "Duración"

msgid "Email address"
msgstr "Dirección de correo electrónico"

msgid "File path"
msgstr "Ruta de archivo"

#, python-format
msgid "“%(value)s” value must be a float."
msgstr ""

msgid "Floating point number"
msgstr "Número de punto flotante"

#, python-format
msgid "“%(value)s” value must be an integer."
msgstr ""

