msgstr ""

msgid "Are you sure?"
msgstr "ಖಚಿತಪಡಿಸುವಿರಾ? "

#, python-format
msgid "Delete selected %(verbose_name_plural)s"
msgstr ""

msgid "Administration"
msgstr ""

msgid "All"
msgstr "ಎಲ್ಲಾ"

msgid "Yes"
msgstr "ಹೌದು"

msgid "No"
msgstr "ಇಲ್ಲ"

msgid "Unknown"
msgstr "ಗೊತ್ತಿಲ್ಲ(ದ/ದ್ದು)"

