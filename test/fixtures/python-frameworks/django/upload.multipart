msgstr "Atkļūdošanas logs (serializēta vērtība)"

msgid "No feeds are registered."
msgstr "Nav reģistrētu barotņu."

#, python-format
msgid "Slug %r isn’t registered."
msgstr "Vienkāršotais nosaukums %r nav reģistrēts."

