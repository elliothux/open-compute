msgid "Humanize"
msgstr "Humanisation"

#. Translators: Ordinal format when value is 1 (1st).
#, python-brace-format
msgctxt "ordinal is 1"
msgid "{}st"
msgstr "{}<sup>er</sup>"

#. Translators: Ordinal format for 11 (11th), 12 (12th), and 13 (13th).
#, python-brace-format
msgctxt "ordinal 11, 12, 13"
msgid "{}th"
msgstr "{}<sup>e</sup>"

#. Translators: Ordinal format when value ends with 0, e.g. 80th.
#, python-brace-format
msgctxt "ordinal 0"
msgid "{}th"
msgstr "{}<sup>e</sup>"

#. Translators: Ordinal format when value ends with 1, e.g. 81st,
#. except 11.
#, python-brace-format
msgctxt "ordinal 1"
msgid "{}st"
msgstr "{}<sup>e</sup>"

#. Translators: Ordinal format when value ends with 2, e.g. 82nd,
#. except 12.
#, python-brace-format
msgctxt "ordinal 2"
msgid "{}nd"
msgstr "{}<sup>e</sup>"

#. Translators: Ordinal format when value ends with 3, e.g. 83rd,
#. except 13.
#, python-brace-format
msgctxt "ordinal 3"
msgid "{}rd"
msgstr "{}<sup>e</sup>"

#. Translators: Ordinal format when value ends with 4, e.g. 84th.
#, python-brace-format
msgctxt "ordinal 4"
msgid "{}th"
msgstr "{}<sup>e</sup>"

#. Translators: Ordinal format when value ends with 5, e.g. 85th.
#, python-brace-format
msgctxt "ordinal 5"
msgid "{}th"
msgstr "{}<sup>e</sup>"

#. Translators: Ordinal format when value ends with 6, e.g. 86th.
#, python-brace-format
msgctxt "ordinal 6"
msgid "{}th"
msgstr "{}<sup>e</sup>"

#. Translators: Ordinal format when value ends with 7, e.g. 87th.
#, python-brace-format
msgctxt "ordinal 7"
msgid "{}th"
msgstr "{}<sup>e</sup>"

#. Translators: Ordinal format when value ends with 8, e.g. 88th.
#, python-brace-format
msgctxt "ordinal 8"
msgid "{}th"
msgstr "{}<sup>e</sup>"

#. Translators: Ordinal format when value ends with 9, e.g. 89th.
#, python-brace-format
msgctxt "ordinal 9"
msgid "{}th"
msgstr "{}<sup>e</sup>"

#, python-format
