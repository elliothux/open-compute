msgid "%(value)s octillion"
msgid_plural "%(value)s octillion"
msgstr[0] "%(value)s октилион"
msgstr[1] "%(value)s октилиони"

#, python-format
msgid "%(value).1f nonillion"
msgid_plural "%(value).1f nonillion"
