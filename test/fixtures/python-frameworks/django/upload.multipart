msgid "Humanize"
msgstr "Хуманизирање"

msgid "th"
msgstr "ти"

msgid "st"
msgstr "ви"

msgid "nd"
msgstr "ри"

msgid "rd"
msgstr "ти"

#, python-format
msgid "%(value).1f million"
msgid_plural "%(value).1f million"
msgstr[0] "%(value).1f милион"
msgstr[1] "%(value).1f милиони"

#, python-format
msgid "%(value)s million"
msgid_plural "%(value)s million"
