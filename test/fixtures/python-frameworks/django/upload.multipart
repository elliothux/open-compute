msgstr[0] "%(value).1f miliardoj"
msgstr[1] "%(value).1f miliardoj"

#, python-format
msgid "%(value)s billion"
msgid_plural "%(value)s billion"
msgstr[0] "%(value)s miliardoj"
msgstr[1] "%(value)s miliardoj"

#, python-format
