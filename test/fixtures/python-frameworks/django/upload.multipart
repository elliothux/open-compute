    View function: <code>{{ full_name }}</code>. Name: <code>{{ url_name }}</code>.
{% endblocktranslate %}</p>
<p>{{ view.title }}</p>
<hr>
{% endifchanged %}
{% endfor %}
</div>
{% endfor %}
</div>
{% endblock %}

