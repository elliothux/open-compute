Content-Disposition: form-data; name="./python_modules/django/contrib/admin/locale/pt/LC_MESSAGES/djangojs.po"; filename="./python_modules/django/contrib/admin/locale/pt/LC_MESSAGES/djangojs.po"
Content-Type: application/octet-stream

# This file is distributed under the same license as the Django package.
