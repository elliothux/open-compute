msgstr "%(field_labels)s hauek dauzkan %(model_name)s dagoeneko existitzen da."

#, python-format
msgid "Constraint “%(name)s” is violated."
msgstr ""

#, python-format
msgid "Value %(value)r is not a valid choice."
msgstr "%(value)r balioa ez da baleko aukera bat."

