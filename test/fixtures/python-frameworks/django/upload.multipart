msgid ""
msgstr ""
"Project-Id-Version: django\n"
"Report-Msgid-Bugs-To: \n"
"POT-Creation-Date: 2026-05-20 15:53-0400\n"
"PO-Revision-Date: 2026-08-05 18:40+0000\n"
"Last-Translator: Igor Jerosimić, 2021,2023-2026\n"
