msgstr ""

msgid "Date/time"
msgstr "তারিখ/সময়"

msgid "User"
msgstr "সদস্য"

msgid "Action"
msgstr "কার্য"

msgid "entry"
msgstr ""

msgid "entries"
msgstr ""

