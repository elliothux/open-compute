msgid "Redirects"
msgstr "बाटो फेर्ने"

msgid "site"
msgstr "साईट"

msgid "redirect from"
msgstr "बाटो फेर्ने फरम"

msgid ""
"This should be an absolute path, excluding the domain name. Example: '/"
"events/search/'."
msgstr "यो डोमेन नाम छोडेर, पूर्ण बाटो हुनुपर्छ । उदाहरण : '/events/search'"

msgid "redirect to"
msgstr "बाटो फेर्नेको लागि"

msgid ""
"This can be either an absolute path (as above) or a full URL starting with "
"'http://'."
msgstr ""
"यो कि (माथीको जस्तै )पूर्ण  बाटो हुनुपर्छ  वा 'http://' बाट  सुरुभएको पुरा हुनुपर्छ । "

msgid "redirect"
msgstr "बाटो फेर्ने"

msgid "redirects"
msgstr "बाटो फेर्ने"

------formdata-undici-069060341488
