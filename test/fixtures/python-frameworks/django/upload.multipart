msgstr "एक समय चुनें"

msgid "Midnight"
msgstr "मध्यरात्री"

msgid "6 a.m."
msgstr "सुबह 6 बजे"

msgid "Noon"
msgstr "दोपहर"

msgid "6 p.m."
msgstr ""

