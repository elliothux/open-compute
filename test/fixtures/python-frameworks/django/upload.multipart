msgid "February"
msgstr "Februarie"

msgctxt "alt. month"
msgid "March"
msgstr "Maart"

msgctxt "alt. month"
msgid "April"
msgstr "April"

msgctxt "alt. month"
msgid "May"
msgstr "Mei"

msgctxt "alt. month"
msgid "June"
msgstr "Junie"

