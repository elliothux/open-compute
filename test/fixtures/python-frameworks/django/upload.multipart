#, python-format
msgctxt "naturaltime"
msgid "%(delta)s ago"
msgstr "%(delta)s আগে"

msgid "now"
msgstr "এখন"

#. Translators: please keep a non-breaking space (U+00A0)
#. between count and time unit.
#, python-format
msgid "a second ago"
msgid_plural "%(count)s seconds ago"
