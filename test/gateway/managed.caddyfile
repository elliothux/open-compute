{
    admin "unix//data/gateway/run/admin.sock"
    persist_config off
    storage file_system "/data/gateway/storage"
    auto_https disable_redirects
    https_port 8443
    acme_ca https://acme-v02.api.letsencrypt.org/directory
    default_bind 127.0.0.1
    servers 127.0.0.1:8443 {
        protocols h1 h2
        strict_sni_host on
        listener_wrappers {
            proxy_protocol {
                timeout 2s
                allow 192.0.2.0/24
                fallback_policy reject
            }
            tls
        }
    }
}

https://*.compute.example.com:8443 {
    tls {
        dns opencompute "/data/gateway/run/challenge-provider.sock"
    }
    reverse_proxy "unix//data/runtime/gateway-upstream.sock" {
        header_up Host {host}
        header_up -Forwarded
        header_up -X-Forwarded-*
        header_up -CF-Connecting-IP
        header_up CF-Connecting-IP {remote_ip}
        header_up -X-Open-Compute-*
        transport http {
            dial_timeout 2s
        }
    }
}
