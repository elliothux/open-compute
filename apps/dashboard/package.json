{
  "name": "@open-compute/dashboard",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://open-compute.dev",
  "type": "module",
  "scripts": {
    "build": "vite build && bun run typecheck",
    "dev": "vite",
    "format": "prettier --write --ignore-path ../../.prettierignore --ignore-unknown .",
    "format:check": "prettier --check --ignore-path ../../.prettierignore --ignore-unknown .",
    "lint": "oxlint --disable-nested-config --deny-warnings .",
    "lint:fix": "oxlint --disable-nested-config --fix --deny-warnings .",
    "preview": "vite preview",
    "test": "bun test tests/unit",
    "test:e2e": "sh scripts/run-e2e.sh",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cloudflare/kumo": "catalog:",
    "@open-compute/sdk": "workspace:*",
    "@tabler/icons-react": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@wooorm/starry-night": "^3.11.0",
    "cloudflare": "catalog:",
    "date-fns": "catalog:",
    "hast-util-to-html": "^9.0.5",
    "jotai": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vscode-oniguruma": "^2.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
