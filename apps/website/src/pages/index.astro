---
import { App } from "../app";
import "../styles.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Run supported Cloudflare Workers projects on a self-contained, Rust-powered platform: one binary, zero extra dependencies."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Pixel:ELSH@1&family=Roboto:wght@400;500;600;700&family=Saira+Semi+Condensed:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <title>open-compute — Cloudflare-compatible infrastructure in one binary</title>
  </head>
  <body>
    <App client:load />
  </body>
</html>
