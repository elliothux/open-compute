{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "open-compute-website",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-04",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
  },
}
