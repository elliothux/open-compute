      {"id": "workers.observability.telemetry.keys", "status": "supported_with_deviation", "source": "cloudflare-openapi", "constraint": "Bounded local retention index with target-only attribution", "deviations": ["OC-OBSERVABILITY-001"]},
      {"id": "workers.observability.telemetry.values", "status": "supported_with_deviation", "source": "cloudflare-openapi", "constraint": "Bounded local retention index with target-only attribution", "deviations": ["OC-OBSERVABILITY-001"]},
      {"id": "workers.observability.telemetry.query", "status": "supported_with_deviation", "source": "cloudflare-openapi", "constraint": "Events and invocations views over a bounded local index", "deviations": ["OC-OBSERVABILITY-001"]},
      {"id": "workers.observability.telemetry.liveTail", "status": "supported_with_deviation", "source": "cloudflare-dashboard-wire-2026-09-03", "constraint": "Process-local selected-Script stream with target-only attribution", "deviations": ["OC-OBSERVABILITY-001"]},
